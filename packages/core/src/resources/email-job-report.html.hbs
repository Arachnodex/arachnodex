<table cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #e5e5e5; border-radius: 5px; margin-bottom: 18px;">
    <tr>
        <td style="padding: 18px 20px 8px; text-align: left;">
            <div style="color: #4d4d4d; font-size: 22px; font-weight: 700; line-height: 28px;">{{reportTitle}}</div>
            <div style="color: #999999; font-size: 12px; padding-top: 2px;">{{jobHandle}}</div>
        </td>
    </tr>
    {{#if reportMessage}}
    <tr>
        <td style="padding: 0 20px 12px; color: #777777; text-align: left;">
            {{{reportMessageHtml}}}
        </td>
    </tr>
    {{/if}}
    {{#if reportData.length}}
    <tr>
        <td style="padding: 0 20px 16px;">
            <table cellpadding="0" cellspacing="0" width="100%">
                {{#each reportData}}
                <tr>
                    <td style="border-top: 1px solid #eeeeee; color: #4d4d4d; font-weight: 700; padding: 8px 0; text-align: left; width: 45%;">{{label}}</td>
                    <td style="border-top: 1px solid #eeeeee; color: #777777; padding: 8px 0; text-align: left;">{{{valueHtml}}}</td>
                </tr>
                {{/each}}
            </table>
        </td>
    </tr>
    {{/if}}
    {{#if reportHtml}}
    <tr>
        <td style="padding: 0 20px 18px; text-align: left;">
            {{{reportHtml}}}
        </td>
    </tr>
    {{/if}}
</table>
